generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id Int @id @default(autoincrement())

  customerName    String
  mobile          String  @unique
  secondaryMobile String?
  whatsapp        String?
  shopName        String?
  customerType    String?

  email String?
  gst   String?

  country  String? @default("India")

state    String?
district String?
city     String?
area     String?
pincode  String?

leadDate DateTime @default(now())

  addressLine1 String?
  addressLine2 String?

  website String?

  leadOwner  String?
  leadSource String?
  language   String?

  priority String?
  status   String?

  expectedValue Float?
  probability   Int?

  products Json?

  followupDate DateTime?
  followupTime String?

  notes String?

  followupCompleted   Boolean   @default(false)
  followupCompletedAt DateTime?
  lastReminderSent    DateTime?
  nextReminder        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notesHistory LeadNote[]
  attachments  LeadAttachment[]
  calls        LeadCall[]
  timeline     LeadTimeline[]
  quotations   Quotation[]
}

model LeadNote {
  id Int @id @default(autoincrement())

  leadId Int
  note   String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadAttachment {
  id Int @id @default(autoincrement())

  leadId Int

  fileName     String
  originalName String
  fileType     String
  fileSize     Int
  filePath     String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadCall {
  id Int @id @default(autoincrement())

  leadId Int

  callType String
  duration Int?
  remarks  String?

  nextFollowup DateTime?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadTimeline {
  id Int @id @default(autoincrement())

  leadId Int

  type        String
  title       String
  description String?
  createdBy   String?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Quotation {
  id Int @id @default(autoincrement())

  leadId Int

  quotationNo String @unique

  customerName String
  companyName  String?
  mobile       String
  address      String?

  subtotal Float
  discount Float @default(0)
  gst      Float @default(0)
  total    Float

  status String @default("Draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  items QuotationItem[]
}

model QuotationItem {
  id Int @id @default(autoincrement())

  quotationId Int

  product     String
  description String?

  qty    Int
  rate   Float
  amount Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  password String

  role String @default("Sales")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
