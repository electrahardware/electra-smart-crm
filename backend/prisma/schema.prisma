generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id Int @id @default(autoincrement())

  customerName    String
  mobile          String  @unique
  secondaryMobile String?
  whatsapp        String?
  shopName        String?
  customerType    String?

  email String?
  gst   String?

  country String? @default("India")

  state    String?
  district String?
  city     String?
  area     String?
  pincode  String?

  leadDate DateTime @default(now())

  addressLine1 String?
  addressLine2 String?

  website String?

  leadOwner  String?
  leadSource String?
  language   String?

  priority String?
  status   String?

  expectedValue Float?
  probability   Int?

  products Json?

  followupDate DateTime?
  followupTime String?

  notes String?

  followupCompleted   Boolean   @default(false)
  followupCompletedAt DateTime?
  lastReminderSent    DateTime?
  nextReminder        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastEditedAt DateTime?
  lastEditedBy String?
  listPriority Int @default(0)

  notesHistory LeadNote[]
  activities   LeadActivity[]
  attachments  LeadAttachment[]
  calls        LeadCall[]
  timeline     LeadTimeline[]
  quotations   Quotation[]


}

model LeadNote {
  id Int @id @default(autoincrement())

  leadId    Int
  note      String
  createdBy String?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadAttachment {
  id Int @id @default(autoincrement())

  leadId Int

  fileName     String
  originalName String
  fileType     String
  fileSize     Int
  filePath     String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadCall {
  id Int @id @default(autoincrement())

  leadId Int

  callType String
  duration Int?
  remarks  String?

  nextFollowup DateTime?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadTimeline {
  id Int @id @default(autoincrement())

  leadId Int

  type        String
  title       String
  description String?
  createdBy   String?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Quotation {
  id Int @id @default(autoincrement())

  leadId Int

  quotationNo String @unique

  customerName String
  companyName  String?
  mobile       String
  address      String?

  subtotal Float
  discount Float @default(0)
  gst      Float @default(0)
  total    Float

  status String @default("Draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  items QuotationItem[]
}

model QuotationItem {
  id Int @id @default(autoincrement())

  quotationId Int

  product     String
  description String?

  qty    Int
  rate   Float
  amount Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  password String

  role String @default("Sales Executive")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

model LeadActivity {
  id Int @id @default(autoincrement())

  leadId Int

  activity String

  description String?

  createdBy String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model AuditLog {
  id Int @id @default(autoincrement())

  module String
  action String

  userId Int?
  userName String

  entityId Int?
  entityName String?

  oldValues Json?
  newValues Json?

  ipAddress String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

model BackupSettings {
  id                   Int      @id @default(1)
  automaticEnabled     Boolean  @default(true)
  frequency            String   @default("Daily")
  backupTime           String   @default("02:00")
  timezone             String   @default("Asia/Kolkata")
  retentionDays        Int      @default(30)
  retentionCount       Int      @default(30)
  googleDriveRootFolderId String?
  lastBackupAt         DateTime?
  nextBackupAt         DateTime?
  latestBackupJobId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model BackupJob {
  id               String   @id @default(cuid())
  idempotencyKey   String?  @unique
  type             String
  status           String   @default("Queued")
  startedAt        DateTime?
  completedAt      DateTime?
  durationMs       Int?
  fileName         String?
  fileSize         BigInt?
  format           String?
  checksum         String?
  verified         Boolean  @default(false)
  verificationAt   DateTime?
  postgresVersion  String?
  tableCount       Int?
  databaseSize     BigInt?
  verificationError String?
  storageProvider  String?  @default("Google Drive")
  storageFileId    String?
  storagePath      String?
  createdBy        String?
  errorStage       String?
  errorMessage     String?
  retryCount       Int      @default(0)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restoreJobs RestoreJob[]

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model RestoreJob {
  id                String   @id @default(cuid())
  backupJobId       String
  snapshotBackupId  String?
  status            String   @default("Blocked")
  initiatedBy       String?
  initiatedByUserId Int?
  operatorIp        String?
  stage             String   @default("Staging")
  durationMs        Int?
  backupName        String?
  startedAt         DateTime?
  completedAt       DateTime?
  verificationResult Json?
  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  backupJob BackupJob @relation(fields: [backupJobId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}
